{
  "name": "mosvera-monorepo",
  "private": true,
  "homepage": "https://mosvera.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mosvera/spec.git"
  },
  "bugs": {
    "url": "https://github.com/mosvera/spec/issues"
  },
  "keywords": [
    "mosvera",
    "aesthetic-infrastructure",
    "ai-native",
    "monorepo",
    "open-standard"
  ],
  "type": "module",
  "workspaces": [
    "runtime",
    "providers/_base",
    "providers/openai",
    "providers/flux",
    "providers/sdxl",
    "mcp"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "ci": "npm run build && npm run typecheck && npm run test:workspaces && npm run test:providers",
    "test:providers": "vitest run providers/test",
    "test:workspaces": "npm run test --workspaces",
    "test": "npm run build && npm run test:workspaces && npm run test:providers",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^4.1.7",
    "@types/node": "^26.6.5"
  }
}
